generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  password      String
  name          String?
  image         String?
  phone         String?
  role          Role           @default(ASESOR)
  fcmToken      String?
  leads          Lead[]        @relation("AssignedLeads")
  contactedLeads Lead[]        @relation("ContactedLeads")
  messages      Message[]      // Relación con mensajes enviados
  notifications Notification[]
  reservations  Reservation[]  @relation("CreatedReservations")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum Role {
  ASESOR
  ADMIN
}

model Lead {
  id           String    @id @default(uuid())
  contactId    String?
  bookingId    String?   @unique
  firstName    String?
  lastName     String?
  phone        String?
  email        String?   @unique
  businessName String?
  city         String?
  source       String?
  status       String    @default("NUEVO")
  tags         String?
  lastActivity String?
  assignedToId String?
  assignedTo   User?     @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes        String?
  visited      Boolean   @default(false)
  visitDate    DateTime?
  visitProject String?
  lote         String?
  etapa        String?
  interests    String?
  rating       String?   @default("FRIO")
  lastNoteAt   DateTime?
  
  // Signing parameters
  signingStatus  String?
  signingDate    DateTime?
  signingProject String?
  signingLote    String?
  signingEtapa   String?

  // Reminder flags for visits
  visitReminderSent1d Boolean @default(false)
  visitReminderSent1h Boolean @default(false)

  // Contacto del asesor y escalamiento de seguimiento
  contacted      Boolean   @default(false) // El asesor confirma que ya atendió al cliente
  contactedAt    DateTime?
  contactedById  String?
  contactedBy    User?     @relation("ContactedLeads", fields: [contactedById], references: [id])
  /// Último recordatorio de seguimiento enviado: 0 ninguno, 1 = 5 min, 2 = 30 min, 3 = 1 día.
  /// Es un contador y no tres banderas para que el cron no pueda saltarse un paso ni repetirlo.
  followupStage  Int       @default(0)

  // UTM Parameters for web leads
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  adId         String?
  adName       String?
  formId       String?

  // Qualification fields
  pie            String?
  monthlyPayment String?
  creditInterest String?
  preferredChannel String?
  inboxUrl       String?
  emailEnabled   Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  conversations Conversation[]
  reservations  Reservation[]
}

model Conversation {
  id        String    @id @default(uuid())
  psid      String    @unique // Page-Scoped ID de Meta, o "web:<sessionId>" en el chat web
  platform  String    // "facebook", "instagram", "tiktok" o "web"
  metaName  String?   // Nombre real desde Meta
  metaImage String?   // Foto de perfil desde Meta
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id])
  messages  Message[]

  // Chat web: presencia del visitante y avisos por correo
  visitorLastSeenAt DateTime? // Última vez que el visitante tuvo la ventana del chat abierta
  visitorNotifiedAt DateTime? // Último aviso enviado al visitante por respuesta del asesor

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  text           String
  senderId       String?      // If sent by an advisor (User.id)
  sender         User?        @relation(fields: [senderId], references: [id])
  senderType     String       // "meta", "visitor" (chat web) o "advisor"
  sourceType     String       @default("DIRECT") // "DIRECT" o "COMMENT"
  sourceId       String?      // ID del mensaje o comentario en Meta
  mediaUrl       String?      // URL de imagen o video adjunto
  postId         String?      // ID de la publicación original
  postContent    String?      // Resumen o URL de imagen de la publicación (contexto)
  media          MessageMedia? // Adjunto guardado en la base (imagen, audio o video)
  createdAt      DateTime     @default(now())
}

/// Adjunto de un mensaje: imagen, audio o video.
///
/// Vive en su propia tabla y no como columna de Message a propósito. El binario
/// se guarda como bytea y la bandeja lista cientos de mensajes por consulta: si
/// la columna estuviera en Message, cualquier findMany sin select explícito
/// arrastraría megabytes de audio sin que nadie los haya pedido.
model MessageMedia {
  id         String   @id @default(uuid())
  messageId  String   @unique
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind       String   // "image", "audio" o "video"
  mimeType   String
  fileName   String?
  sizeBytes  Int
  durationMs Int?     // Duración del audio o video, si el emisor la informó
  data       Bytes    // El archivo en binario. Postgres lo mueve solo a TOAST.
  createdAt  DateTime @default(now())
}

model IntegrationToken {
  id            String   @id @default(cuid())
  platform      String   @unique // "tiktok", "facebook", etc.
  accessToken   String   @db.Text
  refreshToken  String?  @db.Text
  expiresAt     DateTime?
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("INFO")
  leadId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Reservation {
  id            String   @id @default(uuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])

  // Datos personales del cliente
  fullName      String
  email         String
  phone         String
  rut           String
  profession    String?
  civilStatus   String?
  nationality   String?  @default("Chilena")

  // Proyecto inmobiliario
  project       String?
  lote          String?
  etapa         String?

  // Dirección
  street        String?
  streetNumber  String?
  region        String?
  commune       String?

  // Comprobante de pago (base64)
  proofFileName String?
  proofMimeType String?
  proofData     String?  @db.Text

  // Metadatos
  createdById   String?
  createdBy     User?    @relation("CreatedReservations", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
